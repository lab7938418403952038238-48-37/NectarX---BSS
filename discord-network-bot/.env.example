DISCORD_TOKEN=put_your_bot_token_here
# Optional: limit report parsing to these channel IDs (comma-separated). Leave blank to watch all accessible channels.
REPORT_CHANNEL_IDS=
# Optional: channel ID for combined hourly summaries. Leave blank to disable scheduled summaries.
SUMMARY_CHANNEL_ID=
# Summary interval in minutes
SUMMARY_INTERVAL_MINUTES=60
# How long before a macro account is considered offline
ONLINE_TTL_MINUTES=90
